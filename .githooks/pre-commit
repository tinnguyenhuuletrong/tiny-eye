#!/usr/bin/env bash
# Fast gate before every commit: formatting and clippy. Tests run in CI / `make check`.
set -euo pipefail
export PATH="$HOME/.cargo/bin:$PATH"
cargo fmt --all -- --check || { echo "run: make fmt"; exit 1; }
cargo clippy --workspace --all-targets --features tqs/mutants --quiet -- -D warnings  # same features as make lint: one build cache
