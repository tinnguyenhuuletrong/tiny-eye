{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiny-eye.local/schema/dashboard.schema.json",
  "title": "tiny-eye dashboard (YAML in git)",
  "$comment": "Generated by `make schemas` — do not edit; change the source of truth instead.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "panels"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "vars": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Panel"
      }
    }
  },
  "$defs": {
    "Dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "panels"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Panel"
          }
        }
      }
    },
    "Panel": {
      "description": "A panel is data (`query`: what to fetch) plus presentation (`ui`: how to draw it and where).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "$ref": "#/$defs/TqsDocument"
        },
        "ui": {
          "$ref": "#/$defs/PanelUi"
        },
        "materialize": {
          "type": "boolean",
          "description": "keep the panel's computed points and extend them as data settles, so a read computes only what is not stored (timeseries metric queries whose points depend only on their own timestamp; no backfill)"
        }
      }
    },
    "PanelUi": {
      "description": "Everything the UI needs that is not part of the query. Panels flow in list order over a 12-column grid of fixed-height rows.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string",
          "enum": [
            "timeseries",
            "stat",
            "table",
            "bar",
            "traces",
            "logs"
          ],
          "description": "how to draw the result (default by query kind: timeseries → timeseries, trace_search and trace → traces, log_search and log_patterns → logs, table → stat for one series, table for more)"
        },
        "unit": {
          "type": "string",
          "description": "unit shown next to values, e.g. req/s, s, %"
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "width in columns of the 12-column grid (default: 3 for stat or a table-kind query without display, 6 otherwise)"
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "height in rows (default: 2 for stat or a table-kind query without display, 4 otherwise)"
        }
      }
    },
    "TqsAgg": {
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count",
            "absent"
          ]
        },
        "by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "without": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "TqsCond": {
      "properties": {
        "field": {
          "type": "string",
          "description": "a signal field, attr.<key> or resource.<key>"
        },
        "op": {
          "type": "string",
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "=~",
            "!~",
            "contains",
            "in",
            "exists"
          ]
        },
        "value": {
          "description": "string",
          "number": null,
          "boolean or (for in) an array of up to 100 values": null
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op",
        "value"
      ]
    },
    "TqsDerive": {
      "properties": {
        "label": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "regex": {
          "type": "string",
          "maxLength": 256
        },
        "replacement": {
          "type": "string",
          "maxLength": 256
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "from",
        "regex",
        "replacement"
      ]
    },
    "TqsDocument": {
      "properties": {
        "tqs": {
          "type": "string",
          "const": "3"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "timeseries",
            "table",
            "trace_search",
            "trace",
            "log_search",
            "log_patterns"
          ]
        },
        "time": {
          "$ref": "#/$defs/TqsTime"
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          },
          "description": "variables: a string \"$name\" in a matcher value, condition value or fn.window is replaced by vars.name; \"$$text\" is the literal \"$text\""
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/TqsQuery"
          }
        },
        "formulas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TqsFormula"
          }
        },
        "top": {
          "$ref": "#/$defs/TqsTop"
        },
        "search": {
          "$ref": "#/$defs/TqsSearch"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tqs",
        "id",
        "kind"
      ]
    },
    "TqsDuration": {
      "pattern": "^([0-9]+(ms|s|m|h|d|w)|\\$[a-z_][a-z0-9_]*)$",
      "type": "string",
      "description": "positive duration like \"30s\", \"5m\", \"7d\", or a variable \"$name\" / \"$__range\" / \"$__interval\""
    },
    "TqsFn": {
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "rate",
            "increase",
            "irate",
            "delta",
            "resets",
            "changes",
            "last",
            "avg_over_time",
            "min_over_time",
            "max_over_time",
            "sum_over_time",
            "count_over_time",
            "last_over_time",
            "histogram_quantile"
          ]
        },
        "window": {
          "$ref": "#/$defs/TqsDuration"
        },
        "q": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ]
    },
    "TqsFormula": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "expr": {
          "type": "string",
          "maxLength": 512
        },
        "join": {
          "type": "string",
          "enum": [
            "inner",
            "outer"
          ]
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expr"
      ]
    },
    "TqsHaving": {
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "=",
            "!=",
            ">",
            ">=",
            "<",
            "<="
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "value"
      ]
    },
    "TqsMatcher": {
      "properties": {
        "label": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "enum": [
            "=",
            "!=",
            "=~",
            "!~"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "op",
        "value"
      ]
    },
    "TqsMeasure": {
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "count",
            "rate",
            "quantile",
            "avg",
            "min",
            "max",
            "sum"
          ]
        },
        "field": {
          "type": "string",
          "enum": [
            "duration_ms"
          ]
        },
        "q": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ]
    },
    "TqsQuery": {
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "metric": {
          "type": "string"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TqsCond"
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TqsCond"
          }
        },
        "match": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TqsMatcher"
          }
        },
        "fn": {
          "$ref": "#/$defs/TqsFn"
        },
        "measure": {
          "$ref": "#/$defs/TqsMeasure"
        },
        "agg": {
          "$ref": "#/$defs/TqsAgg"
        },
        "then": {
          "$ref": "#/$defs/TqsAgg"
        },
        "derive": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TqsDerive"
          }
        },
        "offset": {
          "$ref": "#/$defs/TqsDuration"
        },
        "having": {
          "$ref": "#/$defs/TqsHaving"
        },
        "fill": {
          "type": "string",
          "enum": [
            "none",
            "zero"
          ]
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "description": "Exactly one of metric, spans, logs."
    },
    "TqsSearch": {
      "properties": {
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TqsCond"
          }
        },
        "trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TqsCond"
          }
        },
        "logs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TqsCond"
          }
        },
        "order": {
          "type": "string",
          "enum": [
            "duration_desc",
            "start_desc",
            "desc",
            "asc"
          ]
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "TqsTime": {
      "properties": {
        "from": {
          "$ref": "#/$defs/TqsTimePoint"
        },
        "to": {
          "$ref": "#/$defs/TqsTimePoint"
        },
        "step": {
          "$ref": "#/$defs/TqsDuration"
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from"
      ]
    },
    "TqsTimePoint": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^(now|-[0-9]+(ms|s|m|h|d|w))$"
        }
      ],
      "description": "epoch ms, \"now\", or \"-<duration>\" relative to now"
    },
    "TqsTop": {
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "query": {
          "type": "string"
        },
        "rank": {
          "type": "string",
          "enum": [
            "per_step",
            "max",
            "avg",
            "last"
          ]
        },
        "order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n"
      ]
    }
  }
}
