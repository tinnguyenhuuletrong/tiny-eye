{
  "$comment": "Generated by `make schemas` — do not edit; change the source of truth instead.",
  "$defs": {
    "Auth": {
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "items": {
            "$ref": "#/$defs/TokenSpec"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ByteSize": {
      "description": "Size: B, KB, MB, GB (powers of 1024), e.g. 64MB",
      "examples": [
        "64MB",
        "1GB"
      ],
      "pattern": "^[0-9]+(B|KB|MB|GB)$",
      "type": "string"
    },
    "Catalog": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "description": "A DuckDB file path (single node) or `postgres:<libpq conninfo>` (cluster).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Coordinator": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_interval": {
          "$ref": "#/$defs/Duration",
          "description": "How often pending envelopes are applied to the catalog."
        },
        "compaction_delay": {
          "$ref": "#/$defs/Duration",
          "description": "Compact an hour this long after it closes."
        },
        "compaction_interval": {
          "$ref": "#/$defs/Duration",
          "description": "How often closed hours are checked for compaction."
        },
        "hot_grace": {
          "$ref": "#/$defs/Duration",
          "description": "Keep committed rows in RAM this long after the catalog has them."
        },
        "retention": {
          "$ref": "#/$defs/Duration",
          "description": "Data older than this is deleted."
        },
        "retention_interval": {
          "$ref": "#/$defs/Duration",
          "description": "How often retention runs."
        }
      },
      "type": "object"
    },
    "Dashboards": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "description": "Directory of dashboard YAML files (schema: schema/generated/dashboard.schema.json).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "DuckDb": {
      "additionalProperties": false,
      "properties": {
        "extension_dir": {
          "description": "`<dir>/<duckdb version>/<platform>/*.duckdb_extension`; empty = auto-install.",
          "type": "string"
        },
        "memory_limit": {
          "type": "string"
        },
        "threads": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Durability": {
      "oneOf": [
        {
          "const": "memory",
          "description": "Ack after arena admission; a crash loses the unflushed batch.",
          "type": "string"
        },
        {
          "const": "wal",
          "description": "Ack after a group-committed fsync to the local WAL; replayed on restart.",
          "type": "string"
        }
      ]
    },
    "Duration": {
      "description": "Duration: ms, s, m, h, d, w, e.g. 60s",
      "examples": [
        "5s",
        "10m",
        "15d"
      ],
      "pattern": "^[0-9]+(ms|s|m|h|d|w)$",
      "type": "string"
    },
    "Ingest": {
      "additionalProperties": false,
      "properties": {
        "arena_limit": {
          "$ref": "#/$defs/ByteSize",
          "description": "Above this many buffered bytes ingest answers 429 / RESOURCE_EXHAUSTED."
        },
        "durability": {
          "$ref": "#/$defs/Durability"
        },
        "flush_bytes": {
          "$ref": "#/$defs/ByteSize",
          "description": "Flush the open batch when it reaches this size..."
        },
        "flush_interval": {
          "$ref": "#/$defs/Duration",
          "description": "...or this age."
        },
        "max_sample_age": {
          "$ref": "#/$defs/Duration",
          "description": "Samples older than this are rejected."
        },
        "max_sample_future": {
          "$ref": "#/$defs/Duration",
          "description": "Samples further ahead than this are rejected."
        },
        "row_group_rows": {
          "description": "Parquet row-group size.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "wal_dir": {
          "description": "Directory of the write-ahead log (durability: wal).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique node id; part of every file name and envelope.",
          "type": "string"
        },
        "region": {
          "description": "Region label stamped on rows (one bucket per region, SPEC §12).",
          "type": "string"
        },
        "tenant": {
          "description": "Tenant stamped on rows (single tenant in v1).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "properties": {
        "timeout": {
          "$ref": "#/$defs/Duration",
          "description": "A query running longer is interrupted."
        },
        "workers": {
          "description": "DuckDB connections serving queries in parallel.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "S3": {
      "additionalProperties": false,
      "properties": {
        "access_key_id": {
          "description": "Secret: prefer the env var TINY_EYE__STORAGE__S3__ACCESS_KEY_ID.",
          "type": "string"
        },
        "allow_http": {
          "type": "boolean"
        },
        "endpoint": {
          "description": "Empty for AWS; e.g. `http://127.0.0.1:19000` for MinIO.",
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "secret_access_key": {
          "description": "Secret: prefer the env var TINY_EYE__STORAGE__S3__SECRET_ACCESS_KEY.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Scope": {
      "enum": [
        "ingest",
        "query",
        "admin"
      ],
      "type": "string"
    },
    "Server": {
      "additionalProperties": false,
      "properties": {
        "listen": {
          "description": "`host:port` to listen on.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Storage": {
      "additionalProperties": false,
      "properties": {
        "s3": {
          "$ref": "#/$defs/S3"
        },
        "url": {
          "description": "`./dir`, `file:///abs/dir` or `s3://bucket/prefix`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "TokenSpec": {
      "additionalProperties": false,
      "properties": {
        "scopes": {
          "items": {
            "$ref": "#/$defs/Scope"
          },
          "type": "array"
        },
        "token_env": {
          "description": "Name of the env var holding the token (tokens never live in the file).",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://tiny-eye.local/schema/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "tiny-eye configuration file (merged over the built-in config/default.yaml).",
  "properties": {
    "auth": {
      "additionalProperties": false,
      "description": "Bearer-token auth; scopes per operation come from api/openapi.yaml (`x-scope`).",
      "properties": {
        "tokens": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TokenSpec"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "catalog": {
      "additionalProperties": false,
      "description": "DuckLake catalog holding table metadata and file lists.",
      "properties": {
        "url": {
          "default": "./data/catalog.ducklake",
          "description": "A DuckDB file path (single node) or `postgres:<libpq conninfo>` (cluster).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "coordinator": {
      "additionalProperties": false,
      "description": "Checkpointer, compactor and retention (SPEC §6).",
      "properties": {
        "checkpoint_interval": {
          "$ref": "#/$defs/Duration",
          "default": "5s",
          "description": "How often pending envelopes are applied to the catalog."
        },
        "compaction_delay": {
          "$ref": "#/$defs/Duration",
          "default": "10m",
          "description": "Compact an hour this long after it closes."
        },
        "compaction_interval": {
          "$ref": "#/$defs/Duration",
          "default": "1m",
          "description": "How often closed hours are checked for compaction."
        },
        "hot_grace": {
          "$ref": "#/$defs/Duration",
          "default": "30s",
          "description": "Keep committed rows in RAM this long after the catalog has them."
        },
        "retention": {
          "$ref": "#/$defs/Duration",
          "default": "15d",
          "description": "Data older than this is deleted."
        },
        "retention_interval": {
          "$ref": "#/$defs/Duration",
          "default": "1h",
          "description": "How often retention runs."
        }
      },
      "type": "object"
    },
    "dashboards": {
      "additionalProperties": false,
      "description": "Dashboards loaded from YAML files at start.",
      "properties": {
        "dir": {
          "default": "./dashboards",
          "description": "Directory of dashboard YAML files (schema: schema/generated/dashboard.schema.json).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "duckdb": {
      "additionalProperties": false,
      "description": "Embedded DuckDB settings.",
      "properties": {
        "extension_dir": {
          "default": "",
          "description": "`<dir>/<duckdb version>/<platform>/*.duckdb_extension`; empty = auto-install.",
          "type": "string"
        },
        "memory_limit": {
          "default": "4GB",
          "type": "string"
        },
        "threads": {
          "default": 4,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ingest": {
      "additionalProperties": false,
      "description": "Write path: durability, flush thresholds, admission limits (SPEC §5).",
      "properties": {
        "arena_limit": {
          "$ref": "#/$defs/ByteSize",
          "default": "1GB",
          "description": "Above this many buffered bytes ingest answers 429 / RESOURCE_EXHAUSTED."
        },
        "durability": {
          "$ref": "#/$defs/Durability",
          "default": "wal"
        },
        "flush_bytes": {
          "$ref": "#/$defs/ByteSize",
          "default": "64MB",
          "description": "Flush the open batch when it reaches this size..."
        },
        "flush_interval": {
          "$ref": "#/$defs/Duration",
          "default": "60s",
          "description": "...or this age."
        },
        "max_sample_age": {
          "$ref": "#/$defs/Duration",
          "default": "1h",
          "description": "Samples older than this are rejected."
        },
        "max_sample_future": {
          "$ref": "#/$defs/Duration",
          "default": "10m",
          "description": "Samples further ahead than this are rejected."
        },
        "row_group_rows": {
          "default": 122880,
          "description": "Parquet row-group size.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "wal_dir": {
          "default": "./data/wal",
          "description": "Directory of the write-ahead log (durability: wal).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "node": {
      "additionalProperties": false,
      "description": "Identity of this node; tenant and region are stamped on every row it ingests.",
      "properties": {
        "id": {
          "default": "node-0",
          "description": "Unique node id; part of every file name and envelope.",
          "type": "string"
        },
        "region": {
          "default": "local",
          "description": "Region label stamped on rows (one bucket per region, SPEC §12).",
          "type": "string"
        },
        "tenant": {
          "default": "default",
          "description": "Tenant stamped on rows (single tenant in v1).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "query": {
      "additionalProperties": false,
      "description": "Query execution limits (SPEC §7).",
      "properties": {
        "timeout": {
          "$ref": "#/$defs/Duration",
          "default": "30s",
          "description": "A query running longer is interrupted."
        },
        "workers": {
          "default": 4,
          "description": "DuckDB connections serving queries in parallel.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "server": {
      "additionalProperties": false,
      "description": "HTTP listener (API, OTLP/HTTP, remote-write, Loki push, /metrics).",
      "properties": {
        "listen": {
          "default": "127.0.0.1:7070",
          "description": "`host:port` to listen on.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "storage": {
      "additionalProperties": false,
      "description": "Object storage for Parquet data files and commit envelopes.",
      "properties": {
        "s3": {
          "additionalProperties": false,
          "properties": {
            "access_key_id": {
              "default": "",
              "description": "Secret: prefer the env var TINY_EYE__STORAGE__S3__ACCESS_KEY_ID.",
              "type": "string"
            },
            "allow_http": {
              "default": false,
              "type": "boolean"
            },
            "endpoint": {
              "default": "",
              "description": "Empty for AWS; e.g. `http://127.0.0.1:19000` for MinIO.",
              "type": "string"
            },
            "region": {
              "default": "us-east-1",
              "type": "string"
            },
            "secret_access_key": {
              "default": "",
              "description": "Secret: prefer the env var TINY_EYE__STORAGE__S3__SECRET_ACCESS_KEY.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "url": {
          "default": "./data/objects",
          "description": "`./dir`, `file:///abs/dir` or `s3://bucket/prefix`.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "title": "tiny-eye configuration",
  "type": "object"
}
