{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiny-eye.local/schema/config.schema.json",
  "title": "tiny-eye configuration",
  "$comment": "Generated by `make schemas` — do not edit; change the source of truth instead.",
  "description": "tiny-eye configuration file (merged over the built-in config/default.yaml).",
  "type": "object",
  "properties": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique node id; part of every file name and envelope.",
          "type": "string",
          "default": "node-0"
        },
        "region": {
          "description": "Region label stamped on rows (one bucket per region, SPEC §12).",
          "type": "string",
          "default": "local"
        },
        "tenant": {
          "description": "Tenant stamped on rows (single tenant in v1).",
          "type": "string",
          "default": "default"
        }
      },
      "additionalProperties": false,
      "description": "Identity of this node; tenant and region are stamped on every row it ingests."
    },
    "server": {
      "type": "object",
      "properties": {
        "listen": {
          "description": "`host:port` to listen on.",
          "type": "string",
          "default": "127.0.0.1:7070"
        }
      },
      "additionalProperties": false,
      "description": "HTTP listener (API, OTLP/HTTP, remote-write, Loki push, /metrics)."
    },
    "storage": {
      "type": "object",
      "properties": {
        "url": {
          "description": "`./dir`, `file:///abs/dir` or `s3://bucket/prefix`.",
          "type": "string",
          "default": "./data/objects"
        },
        "s3": {
          "type": "object",
          "properties": {
            "endpoint": {
              "description": "Empty for AWS; e.g. `http://127.0.0.1:19000` for MinIO.",
              "type": "string",
              "default": ""
            },
            "region": {
              "type": "string",
              "default": "us-east-1"
            },
            "access_key_id": {
              "description": "Secret: prefer the env var TINY_EYE__STORAGE__S3__ACCESS_KEY_ID.",
              "type": "string",
              "default": ""
            },
            "secret_access_key": {
              "description": "Secret: prefer the env var TINY_EYE__STORAGE__S3__SECRET_ACCESS_KEY.",
              "type": "string",
              "default": ""
            },
            "allow_http": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Object storage for Parquet data files and commit envelopes."
    },
    "catalog": {
      "type": "object",
      "properties": {
        "url": {
          "description": "A DuckDB file path (single node) or `postgres:<libpq conninfo>` (cluster).",
          "type": "string",
          "default": "./data/catalog.ducklake"
        }
      },
      "additionalProperties": false,
      "description": "DuckLake catalog holding table metadata and file lists."
    },
    "duckdb": {
      "type": "object",
      "properties": {
        "extension_dir": {
          "description": "`<dir>/<duckdb version>/<platform>/*.duckdb_extension`; empty = auto-install.",
          "type": "string",
          "default": ""
        },
        "threads": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 4
        },
        "memory_limit": {
          "type": "string",
          "default": "4GB"
        }
      },
      "additionalProperties": false,
      "description": "Embedded DuckDB settings."
    },
    "ingest": {
      "type": "object",
      "properties": {
        "durability": {
          "$ref": "#/$defs/Durability",
          "default": "wal"
        },
        "wal_dir": {
          "description": "Directory of the write-ahead log (durability: wal).",
          "type": "string",
          "default": "./data/wal"
        },
        "flush_bytes": {
          "description": "Flush the open batch when it reaches this size...",
          "$ref": "#/$defs/ByteSize",
          "default": "64MB"
        },
        "flush_interval": {
          "description": "...or this age.",
          "$ref": "#/$defs/Duration",
          "default": "60s"
        },
        "max_sample_age": {
          "description": "Samples older than this are rejected.",
          "$ref": "#/$defs/Duration",
          "default": "1h"
        },
        "max_sample_future": {
          "description": "Samples further ahead than this are rejected.",
          "$ref": "#/$defs/Duration",
          "default": "10m"
        },
        "arena_limit": {
          "description": "Above this many buffered bytes ingest answers 429 / RESOURCE_EXHAUSTED.",
          "$ref": "#/$defs/ByteSize",
          "default": "1GB"
        },
        "row_group_rows": {
          "description": "Parquet row-group size.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 122880
        }
      },
      "additionalProperties": false,
      "description": "Write path: durability, flush thresholds, admission limits (SPEC §5)."
    },
    "coordinator": {
      "type": "object",
      "properties": {
        "checkpoint_interval": {
          "description": "How often pending envelopes are applied to the catalog.",
          "$ref": "#/$defs/Duration",
          "default": "5s"
        },
        "hot_grace": {
          "description": "Keep committed rows in RAM this long after the catalog has them.",
          "$ref": "#/$defs/Duration",
          "default": "30s"
        },
        "compaction_interval": {
          "description": "How often closed hours are checked for compaction.",
          "$ref": "#/$defs/Duration",
          "default": "1m"
        },
        "compaction_delay": {
          "description": "Compact an hour this long after it closes.",
          "$ref": "#/$defs/Duration",
          "default": "10m"
        },
        "retention": {
          "description": "Data older than this is deleted.",
          "$ref": "#/$defs/Duration",
          "default": "15d"
        },
        "retention_interval": {
          "description": "How often retention runs.",
          "$ref": "#/$defs/Duration",
          "default": "1h"
        }
      },
      "additionalProperties": false,
      "description": "Checkpointer, compactor and retention (SPEC §6)."
    },
    "query": {
      "type": "object",
      "properties": {
        "timeout": {
          "description": "A query taking longer from arrival (waiting for a free connection included) is interrupted.",
          "$ref": "#/$defs/Duration",
          "default": "30s"
        },
        "workers": {
          "description": "DuckDB connections serving queries in parallel.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 4
        }
      },
      "additionalProperties": false,
      "description": "Query execution limits (SPEC §7)."
    },
    "auth": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenSpec"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "description": "Bearer-token auth; scopes per operation come from api/openapi.yaml (`x-scope`)."
    },
    "dashboards": {
      "type": "object",
      "properties": {
        "dir": {
          "description": "Directory of dashboard YAML files (schema: schema/generated/dashboard.schema.json).",
          "type": "string",
          "default": "./dashboards"
        }
      },
      "additionalProperties": false,
      "description": "Dashboards loaded from YAML files at start."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique node id; part of every file name and envelope.",
          "type": "string"
        },
        "region": {
          "description": "Region label stamped on rows (one bucket per region, SPEC §12).",
          "type": "string"
        },
        "tenant": {
          "description": "Tenant stamped on rows (single tenant in v1).",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Server": {
      "type": "object",
      "properties": {
        "listen": {
          "description": "`host:port` to listen on.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Storage": {
      "type": "object",
      "properties": {
        "url": {
          "description": "`./dir`, `file:///abs/dir` or `s3://bucket/prefix`.",
          "type": "string"
        },
        "s3": {
          "$ref": "#/$defs/S3"
        }
      },
      "additionalProperties": false
    },
    "S3": {
      "type": "object",
      "properties": {
        "endpoint": {
          "description": "Empty for AWS; e.g. `http://127.0.0.1:19000` for MinIO.",
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "access_key_id": {
          "description": "Secret: prefer the env var TINY_EYE__STORAGE__S3__ACCESS_KEY_ID.",
          "type": "string"
        },
        "secret_access_key": {
          "description": "Secret: prefer the env var TINY_EYE__STORAGE__S3__SECRET_ACCESS_KEY.",
          "type": "string"
        },
        "allow_http": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Catalog": {
      "type": "object",
      "properties": {
        "url": {
          "description": "A DuckDB file path (single node) or `postgres:<libpq conninfo>` (cluster).",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "DuckDb": {
      "type": "object",
      "properties": {
        "extension_dir": {
          "description": "`<dir>/<duckdb version>/<platform>/*.duckdb_extension`; empty = auto-install.",
          "type": "string"
        },
        "threads": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "memory_limit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Ingest": {
      "type": "object",
      "properties": {
        "durability": {
          "$ref": "#/$defs/Durability"
        },
        "wal_dir": {
          "description": "Directory of the write-ahead log (durability: wal).",
          "type": "string"
        },
        "flush_bytes": {
          "description": "Flush the open batch when it reaches this size...",
          "$ref": "#/$defs/ByteSize"
        },
        "flush_interval": {
          "description": "...or this age.",
          "$ref": "#/$defs/Duration"
        },
        "max_sample_age": {
          "description": "Samples older than this are rejected.",
          "$ref": "#/$defs/Duration"
        },
        "max_sample_future": {
          "description": "Samples further ahead than this are rejected.",
          "$ref": "#/$defs/Duration"
        },
        "arena_limit": {
          "description": "Above this many buffered bytes ingest answers 429 / RESOURCE_EXHAUSTED.",
          "$ref": "#/$defs/ByteSize"
        },
        "row_group_rows": {
          "description": "Parquet row-group size.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Durability": {
      "oneOf": [
        {
          "description": "Ack after arena admission; a crash loses the unflushed batch.",
          "type": "string",
          "const": "memory"
        },
        {
          "description": "Ack after a group-committed fsync to the local WAL; replayed on restart.",
          "type": "string",
          "const": "wal"
        }
      ]
    },
    "ByteSize": {
      "description": "Size: B, KB, MB, GB (powers of 1024), e.g. 64MB",
      "type": "string",
      "pattern": "^[0-9]+(B|KB|MB|GB)$",
      "examples": [
        "64MB",
        "1GB"
      ]
    },
    "Duration": {
      "description": "Duration: ms, s, m, h, d, w, e.g. 60s",
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m|h|d|w)$",
      "examples": [
        "5s",
        "10m",
        "15d"
      ]
    },
    "Coordinator": {
      "type": "object",
      "properties": {
        "checkpoint_interval": {
          "description": "How often pending envelopes are applied to the catalog.",
          "$ref": "#/$defs/Duration"
        },
        "hot_grace": {
          "description": "Keep committed rows in RAM this long after the catalog has them.",
          "$ref": "#/$defs/Duration"
        },
        "compaction_interval": {
          "description": "How often closed hours are checked for compaction.",
          "$ref": "#/$defs/Duration"
        },
        "compaction_delay": {
          "description": "Compact an hour this long after it closes.",
          "$ref": "#/$defs/Duration"
        },
        "retention": {
          "description": "Data older than this is deleted.",
          "$ref": "#/$defs/Duration"
        },
        "retention_interval": {
          "description": "How often retention runs.",
          "$ref": "#/$defs/Duration"
        }
      },
      "additionalProperties": false
    },
    "Query": {
      "type": "object",
      "properties": {
        "timeout": {
          "description": "A query taking longer from arrival (waiting for a free connection included) is interrupted.",
          "$ref": "#/$defs/Duration"
        },
        "workers": {
          "description": "DuckDB connections serving queries in parallel.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Auth": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TokenSpec"
          }
        }
      },
      "additionalProperties": false
    },
    "TokenSpec": {
      "type": "object",
      "properties": {
        "token_env": {
          "description": "Name of the env var holding the token (tokens never live in the file).",
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scope"
          }
        }
      },
      "additionalProperties": false
    },
    "Scope": {
      "type": "string",
      "enum": [
        "ingest",
        "query",
        "admin"
      ]
    },
    "Dashboards": {
      "type": "object",
      "properties": {
        "dir": {
          "description": "Directory of dashboard YAML files (schema: schema/generated/dashboard.schema.json).",
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
