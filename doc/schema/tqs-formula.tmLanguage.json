{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated by `make schemas` from tqs::formula::FUNCS — do not edit.",
  "name": "TQS formula",
  "patterns": [
    {
      "match": "\\b(abs|round|least|greatest|clamp|coalesce)(?=\\s*\\()",
      "name": "support.function.tqs"
    },
    {
      "match": "\\btime\\b",
      "name": "variable.language.time.tqs"
    },
    {
      "match": "\\b\\d+(\\.\\d+)?([eE][-+]?\\d+)?\\b",
      "name": "constant.numeric.tqs"
    },
    {
      "match": "\\b[a-z][a-z0-9_]{0,31}\\b",
      "name": "variable.other.query.tqs"
    },
    {
      "match": "[-+*/]",
      "name": "keyword.operator.arithmetic.tqs"
    },
    {
      "match": "[(),]",
      "name": "punctuation.tqs"
    },
    {
      "match": "[^\\s]",
      "name": "invalid.illegal.tqs"
    }
  ],
  "scopeName": "source.tqs-formula"
}
