{
  "name": "tiny-eye-ui",
  "private": true,
  "type": "module",
  "description": "tiny-eye web UI: dashboards, Explore, traces, logs. Built into the tiny-eye binary.",
  "scripts": {
    "gen": "openapi-typescript ../api/openapi.yaml -o src/api.gen.ts",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc --noEmit && vite build",
    "typecheck": "npm run gen && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "preact": "11.2.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@preact/preset-vite": "2.10.6",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
